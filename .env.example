# Two Supabase projects: dev (workout-app-dev) for `npm start`, production (workout-app) for
# `npm run start:prod` and production builds. Copy this to .env.development.local and
# .env.production.local (both git-ignored) and fill each in from Supabase:
# Project Settings → API Keys. Both values are safe to ship in the app; Row Level Security
# protects the data. Never put the secret / service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# development in the dev file, production in the production one. Keeps dev data on the phone
# apart from the real account's.
EXPO_PUBLIC_APP_ENV=development
